    # ---------- font size management ----------
    def on_font_size_changed(self, size_text: str):
        try:
            size = int(size_text)
            # Create new font with selected size
            new_font = QFont()
            new_font.setPointSize(size)
            
            # Apply to the entire application
            QApplication.instance().setFont(new_font)
            
            # Also update the output text specifically (since it had custom font)
            output_font = QFont()
            output_font.setPointSize(size)
            self.output.setFont(output_font)
            
        except ValueError:
            pass  # Ignore invalid font sizes

    # ---------- class management ----------
    def on_class_changed(self, name: str):
        self.student_list.clear()
        if not name:
            return
        for s in load_class(name):
            self._add_student_item(s, checked=True)

    def add_class(self):
        name = self.new_class_name.text().strip()
        if not name:
            QMessageBox.warning(self, "Class name", "Please enter a class name.")
            return
        if name in [self.class_combo.itemText(i) for i in range(self.class_combo.count())]:
            QMessageBox.information(self, "Exists", "That class already exists.")
        else:
            save_class(name, [])
            self.class_combo.addItem(name)
            self.class_combo.setCurrentText(name)
        self.new_class_name.clear()

    def delete_class(self):
        name = self.class_combo.currentText()
        if not name:
            return
        if QMessageBox.question(self, "Delete class",
                                f"Delete class '{name}'? This removes its JSON file.") == QMessageBox.Yes:
            p = class_path(name)
            if p.exists():
                p.unlink()
            idx = self.class_combo.currentIndex()
            self.class_combo.removeItem(idx)
            self.student_list.clear()

    # ---------- student list ----------
    def _add_student_item(self, s: str, checked=True):
        item = QListWidgetItem(s)
        item.setFlags(item.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsEditable | Qt.ItemIsSelectable | Qt.ItemIsEnabled)
        item.setCheckState(Qt.Checked if checked else Qt.Unchecked)
        self.student_list.addItem(item)

    def add_student(self):
        s = self.student_input.text().strip()
        if not s:
            return
        names = [self.student_list.item(i).text() for i in range(self.student_list.count())]
        if s in names:
            QMessageBox.information(self, "Duplicate", f"'{s}' is already in the list.")
        else:
            self._add_student_item(s, checked=True)
        self.student_input.clear()

    def remove_selected(self):
        for item in self.student_list.selectedItems():
            self.student_list.takeItem(self.student_list.row(item))

    def check_all(self):
        for i in range(self.student_list.count()):
            self.student_list.item(i).setCheckState(Qt.Checked)

    def uncheck_all(self):
        for i in range(self.student_list.count()):
            self.student_list.item(i).setCheckState(Qt.Unchecked)

    # ---------- persistence ----------
    def save_current_class(self):
        name = self.class_combo.currentText()
        if not name:
            QMessageBox.warning(self, "No class", "Create/select a class first.")
            return
        students = [self.student_list.item(i).text() for i in range(self.student_list.count())]
        save_class(name, students)
        QMessageBox.information(self, "Saved", f"Saved {len(students)} students for '{name}'.")

    # ---------- grouping ----------
    def parse_seed(self, s: str):
        t = (s or "").strip()
        if t == "" or t.lower() == "none":
            return None
        try:
            return int(t)
        except ValueError:
            return None

    def present_students(self) -> list[str]:
        out = []
        for i in range(self.student_list.count()):
            item = self.student_list.item(i)
            if item.checkState() == Qt.Checked:
                out.append(item.text())
        return out

    def generate_plan(self):
        students = self.present_students()
        n_groups = self.groups_spin.value()
        n_rounds = self.rounds_spin.value()
        restarts = self.restarts_spin.value()
        seed = self.parse_seed(self.seed_edit.text())

        self.output.clear()
        if len(students) < n_groups:
            self.output.appendPlainText(
                f"Error: Not enough present students ({len(students)}) for {n_groups} groups."
            )
            return

        plan = schedule_groups(
            students, n_groups=n_groups, rounds=n_rounds, seed=seed, restarts=restarts
        )
        self.current_plan = plan

        # Render plan
        cname = self.class_combo.currentText() or "(unsaved class)"
        self.output.appendPlainText(
            f"Class: {cname} | Students present: {len(students)} | Groups/round: {n_groups} | Rounds: {n_rounds}\n"
        )
        for r, groups in enumerate(plan, start=1):
            self.output.appendPlainText(f"-------- Round {r} --------")
            for i, g in enumerate(groups, start=1):
                self.output.appendPlainText(f"Group {i}: {', '.join(g)}")
            self.output.appendPlainText("")

        # Quality summary
        overall, per_round, counts = schedule_quality(plan)
        o = counts["overall"]
        self.output.appendPlainText("=== QUALITY INDEX ===")
        self.output.appendPlainText(f"Overall: {overall:6.2f}%  (new pairs: {o['new']} / {o['total']})")
        for r, (pct, c) in enumerate(zip(per_round, counts["per_round"]), start=1):
            self.output.appendPlainText(f"Round {r}: {pct:6.2f}%  (new pairs: {c['new']} / {c['total']})")

    # ---------- export ----------
    def export_plan(self):
        if not self.current_plan:
            QMessageBox.information(self, "No plan", "Generate a plan first.")
            return
        fname, _ = QFileDialog.getSaveFileName(self, "Export plan", str(DATA_DIR / "plan.txt"), "Text Files (*.txt)")
        if not fname:
            return
        lines = []
        cname = self.class_combo.currentText() or "(unsaved class)"
        lines.append(f"Class: {cname}\n")
        for r, groups in enumerate(self.current_plan, start=1):
            lines.append(f"-------- Round {r} --------\n")
            for i, g in enumerate(groups, start=1):
                lines.append(f"Group {i}: {', '.join(g)}\n")
            lines.append("\n")
        Path(fname).write_text("".join(lines), encoding="utf-8")
        QMessageBox.information(self, "Exported", f"Plan saved to:\n{fname}")

def main():
    app = QApplication(sys.argv)
    
    # Set initial application-wide font size (will be overridden by combo box)
    font = QFont()
    font.setPointSize(10)
    app.setFont(font)
    
    w = MainWindow()
    w.resize(1100, 650)
    w.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
